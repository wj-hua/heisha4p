<?xml version="1.0" encoding="utf-8"?>
<!-- Apple 风格分段选择器选中项：纯白悬浮微光卡片 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item android:top="1dp" android:bottom="0dp" android:left="0.5dp" android:right="0.5dp">
                <shape>
                    <solid android:color="#18000000" />
                    <corners android:radius="8.5dp" />
                </shape>
            </item>
            <item android:bottom="1dp">
                <shape>
                    <solid android:color="@color/segmented_item_selected" />
                    <corners android:radius="8dp" />
                    <stroke android:width="0.5dp" android:color="#0D000000" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
