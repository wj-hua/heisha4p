<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 苹果 iOS 风格滑块阴影 -->
    <item android:top="1dp" android:bottom="0dp" android:left="1dp" android:right="1dp">
        <shape android:shape="oval">
            <solid android:color="#22000000" />
            <size android:width="27dp" android:height="27dp" />
        </shape>
    </item>
    <item android:top="0.5dp" android:bottom="1.5dp" android:left="1dp" android:right="1dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
            <stroke android:width="0.5dp" android:color="#0D000000" />
            <size android:width="27dp" android:height="27dp" />
        </shape>
    </item>
</layer-list>
