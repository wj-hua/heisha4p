<?xml version="1.0" encoding="utf-8"?>
<!-- Apple HIG 风格「冰封制冷背夹 4Pro」主控制台 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- 顶部导航栏 -->
    <TextView
        style="@style/TopTitle"
        android:text="@string/device_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 硬件展示台 Hero Section -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <!-- 柔和背光氛围 -->
                <View
                    android:layout_width="260dp"
                    android:layout_height="260dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_hero_glow" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="215dp"
                    android:layout_gravity="center"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/device_title"
                    android:src="@drawable/cooler_mag_4pro" />
            </FrameLayout>

            <!-- Apple 风格分段选择器 (Segmented Control) -->
            <LinearLayout
                android:id="@+id/modeBar"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_mode_bar"
                android:orientation="horizontal"
                android:padding="3dp">

                <LinearLayout
                    android:id="@+id/modeSilent"
                    style="@style/ModeItem">
                    <ImageView style="@style/ModeIcon" android:src="@drawable/ic_mode_silent" />
                    <TextView style="@style/ModeText" android:text="静音" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/modeOverclock"
                    style="@style/ModeItem">
                    <ImageView style="@style/ModeIcon" android:src="@drawable/ic_mode_overclock" />
                    <TextView style="@style/ModeText" android:text="超频" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/modeSmart"
                    style="@style/ModeItem">
                    <ImageView style="@style/ModeIcon" android:src="@drawable/ic_mode_smart" />
                    <TextView style="@style/ModeText" android:text="智享" />
                </LinearLayout>
            </LinearLayout>

            <!-- 模式说明（Apple Footnote 风格，位于分段器下方直接呼应选择） -->
            <TextView
                android:id="@+id/tvModeDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:minHeight="20dp"
                android:paddingHorizontal="24dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- 未连接面板 (panelConnect) -->
            <LinearLayout
                android:id="@+id/panelConnect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:orientation="vertical">

                <TextView
                    style="@style/SectionHeader"
                    android:text="设备连接" />

                <!-- 状态与搜索卡片 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvConnState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:id="@+id/devicesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/btnScan"
                        style="@style/GreyButton"
                        android:layout_marginTop="16dp"
                        android:text="搜索背夹" />
                </LinearLayout>
            </LinearLayout>

            <!-- 已连接面板 (panelDevice - Apple Inset Grouped 架构) -->
            <LinearLayout
                android:id="@+id/panelDevice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:orientation="vertical">

                <!-- 分组 1：运行状态 (Apple Fitness / Health 双指标磁贴) -->
                <TextView
                    style="@style/SectionHeader"
                    android:text="运行状态" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- 左侧：背夹制冷面温度 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_metric_cold"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:src="@drawable/ic_temp_cold"
                                android:importantForAccessibility="no" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="背夹温度"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvTemp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/temp_cold"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="制冷接触面"
                            android:textColor="@color/text_tertiary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 右侧：散热片温度 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_metric_hot"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:src="@drawable/ic_temp_hot"
                                android:importantForAccessibility="no" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="散热片温度"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvHotTemp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/temp_hot"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="风道排出端"
                            android:textColor="@color/text_tertiary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 分组 2：控制与功能 -->
                <TextView
                    style="@style/SectionHeader"
                    android:text="功能控制" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical">

                    <!-- 制冷开关 -->
                    <LinearLayout
                        android:id="@+id/rowCooling"
                        style="@style/Row"
                        android:layout_height="62dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="制冷"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="风扇与半导体制冷片协同工作"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/swCooling"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:clickable="false"
                            android:focusable="false"
                            android:splitTrack="false"
                            android:thumb="@drawable/bg_ios_switch_thumb"
                            android:track="@drawable/bg_ios_switch_track" />
                    </LinearLayout>

                    <View style="@style/Divider" />

                    <!-- 灯效设置 -->
                    <LinearLayout
                        android:id="@+id/rowLight"
                        style="@style/Row">

                        <TextView
                            style="@style/RowTitle"
                            android:text="灯效设置" />

                        <ImageView style="@style/RowArrow" />
                    </LinearLayout>

                    <View style="@style/Divider" />

                    <!-- 定时关闭 -->
                    <LinearLayout
                        android:id="@+id/rowTimer"
                        style="@style/Row">

                        <TextView
                            style="@style/RowTitle"
                            android:text="定时关闭" />

                        <TextView
                            android:id="@+id/tvTimer"
                            style="@style/RowValue" />

                        <ImageView style="@style/RowArrow" />
                    </LinearLayout>

                    <View style="@style/Divider" />

                    <!-- 低温保护 -->
                    <LinearLayout
                        android:id="@+id/rowLowTemp"
                        style="@style/Row"
                        android:layout_height="62dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="低温保护"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="防止过度制冷导致冷凝水或结冰"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/swLowTemp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:clickable="false"
                            android:focusable="false"
                            android:splitTrack="false"
                            android:thumb="@drawable/bg_ios_switch_thumb"
                            android:track="@drawable/bg_ios_switch_track" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 分组 3：设备信息 -->
                <TextView
                    style="@style/SectionHeader"
                    android:text="设备信息" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical">

                    <LinearLayout style="@style/Row">
                        <TextView style="@style/RowTitle" android:text="固件版本" />
                        <TextView android:id="@+id/tvFirmware" style="@style/RowValue" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 操作按钮：断开连接 -->
                <TextView
                    android:id="@+id/btnDisconnect"
                    style="@style/DestructiveButton"
                    android:layout_marginTop="24dp"
                    android:text="断开连接" />
            </LinearLayout>

            <!-- 调试日志区域 -->
            <TextView
                android:id="@+id/btnLog"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="BLE 调试日志"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_button_grey"
                android:fontFamily="monospace"
                android:padding="12dp"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
